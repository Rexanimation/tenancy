# =====================================
# LOCAL DEVELOPMENT ENVIRONMENT
# =====================================
# Copy this file as .env in the backend folder and fill in your values

# =====================================
# DATABASE
# =====================================
MONGODB_URI=mongodb://localhost:27017/tenancy-tracker
# OR for MongoDB Atlas (recommended):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/tenancy-tracker?retryWrites=true&w=majority

# =====================================
# GOOGLE OAUTH (LOCAL DEVELOPMENT)
# =====================================
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback
FRONTEND_URL=http://localhost:5173

# =====================================
# SECURITY & SECRETS
# =====================================
JWT_SECRET=your_local_jwt_secret_random_string_here
SESSION_SECRET=your_local_session_secret_random_string_here

# =====================================
# SERVER
# =====================================
PORT=5000
NODE_ENV=development

# =====================================
# RAZORPAY (Payment Gateway)
# =====================================
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# =====================================
# EMAIL CONFIGURATION (GMAIL SMTP - DIRECT)
# =====================================
SMTP_USER_SAHIL=your_gmail_address@gmail.com
SMTP_PASS_SAHIL=your_16_char_app_password
SMTP_USER_NICK=another_gmail_address@gmail.com
SMTP_PASS_NICK=their_16_char_app_password
EMAIL_FROM="Tenancy Tracker" <your_gmail_address@gmail.com>

# =====================================
# ADMIN ACCESS
# =====================================
ADMIN_EMAILS=rajamatiah1258@gmail.com,nicklister402@gmail.com

# =====================================
# NOTES FOR LOCAL SETUP
# =====================================
# 1. MONGODB_URI: Use local MongoDB or create free MongoDB Atlas account
# 2. GOOGLE_CLIENT_ID/SECRET: Get from Google Cloud Console
# 3. RESEND_API_KEY: Sign up on https://resend.com and create an API Key (starts with re_)
# 4. JWT_SECRET & SESSION_SECRET: Generate random strings:
#    - node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 5. Make sure .env is added to .gitignore (never commit secrets!)
